# Copy to .env and fill in what you have. Every Azure service is optional:
# when a key is missing the app falls back to a local or browser equivalent,
# so the whole thing runs on a laptop with no cloud account at all.

PORT=3000
# Public URL of the website, used in QR codes and Photon replies.
PUBLIC_URL=http://localhost:3000
# Salt for hashing player IDs on pest/damage reports. Change it.
REPORT_SALT=change-me

# ---- Storage (Azure Table Storage + Blob Storage) ----
# Leave empty to use local JSON files in .data/ and photos in uploads/.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_TABLE_PREFIX=treedetective
AZURE_BLOB_CONTAINER=tree-photos

# ---- Map background ----
# Defaults to OpenStreetMap's free tiles. Any {z}/{x}/{y} tile URL works.
MAP_TILES_URL=
MAP_TILES_ATTRIBUTION=

# ---- Signed QR tags ----
# Set this before printing tags. Each tag link gets a short key made from it,
# so nobody can wake trees by typing links at home. Changing it breaks old tags.
QR_SECRET=

# ---- Species ID: Pl@ntNet (free, 500/day, my.plantnet.org) ----
# If set, used for species instead of a Custom Vision species model.
PLANTNET_API_KEY=

# ---- 1930s aerial photos (NJ Office of GIS) ----
# Defaults to the state's 1930 WMS. Set HISTORIC_WMS_URL=off to hide it.
HISTORIC_WMS_URL=
HISTORIC_WMS_LAYER=

# ---- Azure Custom Vision (prediction) ----
CUSTOM_VISION_ENDPOINT=
CUSTOM_VISION_KEY=
# Species classifier (tags = species names), only used without PLANTNET_API_KEY
CUSTOM_VISION_SPECIES_PROJECT_ID=
CUSTOM_VISION_SPECIES_ITERATION=
# Optional health classifier (tags: healthy, pest, damage, dying)
CUSTOM_VISION_HEALTH_PROJECT_ID=
CUSTOM_VISION_HEALTH_ITERATION=

# ---- ElevenLabs (tree voices) ----
# If set, ElevenLabs voices the trees (all 4 languages). Azure Speech is the backup.
ELEVENLABS_API_KEY=
# Optional: pick your own voice per persona from the ElevenLabs Voice Library,
# e.g. ELEVENLABS_VOICE_ELDER=<voice id>. Defaults are in data/personas.json.

# ---- Azure Speech (backup voices if ElevenLabs isn't set) ----
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# ---- Google Gemini (backup for writing, fact search and images) ----
# Used for any job Azure OpenAI isn't set up for. Key from aistudio.google.com.
GEMINI_API_KEY=
# Optional model overrides
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ---- Azure OpenAI (pre-writing stories and time-lapse images) ----
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_IMAGE_DEPLOYMENT=
# For "then and now": eras drawn from a reference photo need an image model with edits (gpt-image-1).
AZURE_OPENAI_IMAGE_EDIT_API_VERSION=2025-04-01-preview
# Embedding model for TigerData fact search, e.g. text-embedding-3-small
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# ---- Azure AI Translator (stories in Spanish, Chinese, Hindi, Gujarati) ----
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=eastus

# ---- TigerData (console.cloud.timescale.com) ----
# Postgres connection string of your Tiger Cloud service.
TIGER_DATABASE_URL=

# ---- Photon (Spectrum, iMessage) ----
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
# The iMessage number or address players text (shown on the website).
PHOTON_PHONE_NUMBER=
# Shared secret between the Photon service and the API.
PHOTON_API_KEY=change-me-too
# Where the Photon service reaches the API.
API_BASE=http://localhost:3000
NUDGE_INTERVAL_HOURS=24
# Grounds team phone numbers / iMessage emails for instant "confirmed problem" texts, comma separated.
GROUNDS_ALERT_TO=
