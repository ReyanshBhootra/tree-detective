# Copy to .env and fill in what you have. Every Azure service is optional:
# when a key is missing the app falls back to a local or browser equivalent,
# so the whole thing runs on a laptop with no cloud account at all.

PORT=3000
# Public URL of the website, used in QR codes and Photon replies.
PUBLIC_URL=http://localhost:3000
# Salt for hashing player IDs on pest/damage reports. Change it.
REPORT_SALT=change-me

# ---- Storage (Azure Table Storage + Blob Storage) ----
# Leave empty to use local JSON files in .data/ and photos in uploads/.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_TABLE_PREFIX=treedetective
AZURE_BLOB_CONTAINER=tree-photos

# ---- Azure Custom Vision (prediction) ----
CUSTOM_VISION_ENDPOINT=
CUSTOM_VISION_KEY=
# Species classifier (tags = species names, e.g. "Pin Oak")
CUSTOM_VISION_SPECIES_PROJECT_ID=
CUSTOM_VISION_SPECIES_ITERATION=
# Optional health classifier (tags: healthy, pest, damage, dying)
CUSTOM_VISION_HEALTH_PROJECT_ID=
CUSTOM_VISION_HEALTH_ITERATION=

# ---- Azure Speech (pre-generating each tree's narration) ----
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# ---- Azure OpenAI (pre-writing stories and time-lapse images) ----
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_IMAGE_DEPLOYMENT=

# ---- Photon (Spectrum, iMessage) ----
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
# The iMessage number or address players text (shown on the website).
PHOTON_PHONE_NUMBER=
# Shared secret between the Photon service and the API.
PHOTON_API_KEY=change-me-too
# Where the Photon service reaches the API.
API_BASE=http://localhost:3000
NUDGE_INTERVAL_HOURS=24
